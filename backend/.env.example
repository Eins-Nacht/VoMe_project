DATABASE_URL=sqlite:///./audiary.db
AUDIO_STORAGE_DIR=./uploads/audio
MAX_AUDIO_SIZE_BYTES=52428800
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Legacy combined selector. Use the independent selectors below for new deployments.
PROCESSING_PROVIDER=mock
STT_PROVIDER=faster_whisper
LLM_PROVIDER=
# Never expose OPENAI_API_KEY to Flutter or commit a populated .env file.
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4o-mini
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Empty means automatic language detection. Use "th" for Thai.
WHISPER_LANGUAGE=
# Empty uses the Hugging Face cache (and supports HF_HUB_OFFLINE=1).
WHISPER_MODEL_DIR=
TEMPORARY_AUDIO_MAX_AGE_SECONDS=86400
