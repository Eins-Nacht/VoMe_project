# Never expose OPENAI_API_KEY to Flutter or commit a populated .env file.
OPENAI_API_KEY=
APP_API_TOKEN=
OPENAI_SUMMARY_MODEL=gpt-4o-mini
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_COMPUTE_TYPE=int8
MAX_UPLOAD_BYTES=26214400
DATA_DIR=/data
# Comma-separated browser origins; leave empty for native Flutter only.
CORS_ALLOWED_ORIGINS=http://localhost:3000
