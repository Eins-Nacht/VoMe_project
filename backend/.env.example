DATABASE_URL=sqlite:///./audiary.db
AUDIO_STORAGE_DIR=./uploads/audio
MAX_AUDIO_SIZE_BYTES=52428800
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Faster-Whisper is the mandatory transcription provider. LLM settings are
# optional and are reserved for a future summary integration.
# Never expose OPENAI_API_KEY to Flutter or commit a populated .env file.
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4o-mini
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Transcription is forced to Thai ("th") by the Faster-Whisper provider.
WHISPER_LANGUAGE=th
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:latest
OLLAMA_TIMEOUT_SECONDS=30
# Empty uses the Hugging Face cache (and supports HF_HUB_OFFLINE=1).
WHISPER_MODEL_DIR=
TEMPORARY_AUDIO_MAX_AGE_SECONDS=86400
